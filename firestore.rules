rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // The library id in the URL is the secret. It must be a long, random,
    // URL-safe token. Nothing outside a library path is readable or writable.
    match /libraries/{lid}/{document=**} {
      allow read, write: if lid.size() >= 24 && lid.matches('^[A-Za-z0-9_-]+$');
    }
  }
}
